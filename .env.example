# Copy to .env. Every Settings field in src/app/core/config.py can be set as APP_<FIELD>.
APP_ENVIRONMENT=local
APP_LOG_JSON=false
APP_LOG_LEVEL=INFO

APP_WORKERS=4
APP_KEEPALIVE_TIMEOUT=5
# APP_LIMIT_CONCURRENCY=1000
# APP_LIMIT_MAX_REQUESTS=100000

APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=10
APP_DB_STATEMENT_TIMEOUT_MS=5000
APP_DB_POOL_PRE_PING=true
# docker compose: host port for Postgres if a local one already owns 5432
# POSTGRES_HOST_PORT=5433

# Unset to disable caching entirely.
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_TTL_SECONDS=60

# Unset to disable ClickHouse (analytics endpoints then return 503).
APP_CLICKHOUSE_URL=http://api:api@localhost:8123/default
APP_CLICKHOUSE_MAX_CONCURRENCY=20
APP_CLICKHOUSE_QUEUE_TIMEOUT=1.0
APP_CLICKHOUSE_QUERY_TIMEOUT=10.0

APP_CORS_ORIGINS=["http://localhost:3000"]
